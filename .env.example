# Copy this file to .env.local and fill in the values.
# .env.local is never committed. On Vercel, set these under Project > Settings > Environment Variables.

# Supabase (step 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The only email allowed into /admin
ADMIN_EMAIL=

# Cloudflare Turnstile (ideas form spam check)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Hostnames a token may come from, comma-separated. Production: jambuch.in,www.jambuch.in
# (never localhost). Local: localhost,127.0.0.1
TURNSTILE_HOSTNAMES=

# Resend: emails each new idea to ADMIN_EMAIL
RESEND_API_KEY=
# Optional sender override (default: jambuch.in <ideas@jambuch.in>, a verified domain)
RESEND_FROM=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Empty turns analytics off.
NEXT_PUBLIC_GA_ID=

# Shared secret for the daily keep-awake job
CRON_SECRET=

# Cloudflare R2 (media uploads, later phase; not used yet)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=jambuch-media
# NEXT_PUBLIC_R2_PUBLIC_URL=
