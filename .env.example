# Copy this file to .env.local and fill in the values.
# .env.local is never committed. On Vercel, set these under Project > Settings > Environment Variables.

# Supabase (step 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The only email allowed into /admin
ADMIN_EMAIL=

# Cloudflare Turnstile (ideas form spam check)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Hostnames a token may come from, comma-separated. Production: jambuch.in,www.jambuch.in
# (never localhost). Local: localhost,127.0.0.1
TURNSTILE_HOSTNAMES=

# Resend: emails each new idea to ADMIN_EMAIL
RESEND_API_KEY=
# Optional sender override (default: jambuch.in <ideas@jambuch.in>, a verified domain)
RESEND_FROM=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Empty turns analytics off.
NEXT_PUBLIC_GA_ID=

# Shared secret for the daily job (keep-awake + 30-day Trash cleanup)
CRON_SECRET=

# Cloudflare R2. Files are referenced as https://media.jambuch.in/<key> (public
# bucket) or r2-private:<key> (private bucket). Items in the admin Trash have
# their public files moved to the trash bucket, which must NOT be public.
# The API token needs Object Read & Write on all three buckets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=jambuch-media
R2_TRASH_BUCKET=jambuch-trash
R2_PRIVATE_BUCKET=jambuch-private
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.jambuch.in

# Cloudflare cache purge, so a deleted file's link stops working at once.
# Zone ID of jambuch.in; token with Zone > Cache Purge permission.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
