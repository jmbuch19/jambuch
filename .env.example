# Copy this file to .env.local and fill in the values.
# .env.local is never committed. On Vercel, set these under Project > Settings > Environment Variables.

# Supabase (step 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The only email allowed into /admin
ADMIN_EMAIL=

# Cloudflare Turnstile (ideas form spam check)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (sign-in emails)
RESEND_API_KEY=

# Shared secret for the daily keep-awake job
CRON_SECRET=
